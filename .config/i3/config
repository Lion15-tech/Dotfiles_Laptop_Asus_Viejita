# Archivo de configuración de i3wm

set $mod Mod4

# Fuente general para los títulos e interfaces
font pango:Noto Sans 10

# Establecer teclado en español latinoamericano al iniciar i3
exec --no-startup-id setxkbmap latam

# Iniciar servicios en segundo plano XDG
exec --no-startup-id dex --autostart --environment i3

# Gestor de bloqueo de pantalla y estado de red
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
exec --no-startup-id nm-applet

# Usar la tecla Mod + Clic del mouse para arrastrar ventanas flotantes
floating_modifier $mod

# Mover ventanas en mosaico arrastrándolas desde la barra de título
tiling_drag modifier titlebar

# Abrir la terminal
bindsym $mod+Return exec kitty

# Cerrar la ventana enfocada
bindsym $mod+Shift+q kill

# Lanzador de aplicaciones (rofi)
bindsym $mod+d exec --no-startup-id rofi -show drun -theme ~/.config/rofi/cyberpunk.rasi

# Cambiar el foco entre ventanas (Teclas Vim)
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Cambiar el foco entre ventanas (Flechas de dirección)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Mover ventanas de lugar (Teclas Vim)
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# Mover ventanas de lugar (Flechas de dirección)
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Orientación del corte de pantalla (Horizontal y Vertical)
bindsym $mod+h split h
bindsym $mod+v split v

# Activar / Desactivar modo pantalla completa
bindsym $mod+f fullscreen toggle

# Cambiar el estilo de las ventanas (Apilado, Pestañas, Normal)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Alternar entre ventana flotante y en mosaico
bindsym $mod+Shift+space floating toggle

# Cambiar el foco entre ventanas flotantes y en mosaico
bindsym $mod+space focus mode_toggle

# Enfocar el contenedor padre
bindsym $mod+a focus parent

# Definición de nombres para los 10 espacios de trabajo
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Cambiar al espacio de trabajo
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Mover la ventana enfocada al espacio de trabajo
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Controles Multimedia (Volumen, Brillo y Capturas de pantalla)
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +10%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 10%-

bindsym Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# Recargar configuración y reiniciar i3wm
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m '¿Deseas salir de i3wm?' -B 'Sí, salir' 'i3-msg exit'"

# Modo de cambio de tamaño de ventanas (Resize)
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Ocultar la barra de título azul y usar un borde delgado de 2px
default_border pixel 2
default_floating_border pixel 2

# --- Bordes y Separación Cyberpunk ---
# Espaciado flotante entre ventanas
gaps inner 6
gaps outer 2

# Bordes de ventanas
# clase                 borde   fondo   texto   indicador borde_hijo
client.focused          #ff0055 #0b0e14 #ffffff #ff0055   #ff0055
client.focused_inactive #1a1d24 #0b0e14 #888888 #1a1d24   #1a1d24
client.unfocused        #0b0e14 #0b0e14 #555555 #0b0e14   #0b0e14
client.urgent           #ffee00 #ffee00 #0b0e14 #ffee00   #ffee00
# Configuración de la barra de estado en la parte superior
bar {
    font pango:JetBrainsMono Nerd Font 10
    position top
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    colors {
        background #0b0e14
        statusline #ffffff
        focused_workspace  #ff0055 #ff0055 #ffffff
        active_workspace   #1a1d24 #1a1d24 #ffffff
        inactive_workspace #0b0e14 #0b0e14 #888888
        urgent_workspace   #ffee00 #ffee00 #0b0e14
    }
}

# Fondo de pantalla persistente, o sea que no se quite al reiniciar
exec_always --no-startup-id ~/.fehbg

#Notificación para alerta de la batería de menos de 15%
exec_always --no-startup-id ~/.config/i3/alerta_bateria.sh &

#Bordes

#Picom
exec_always --no-startup-id picom -b

# Bloquear la pantalla
bindsym $mod+Shift+x exec --no-startup-id i3lock -c 0b0e14
